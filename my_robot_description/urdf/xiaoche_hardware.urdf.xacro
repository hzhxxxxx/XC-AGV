<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xiaoche">
  <!-- Robot structure exported from the latest URDF data. -->
  <xacro:include filename="$(find my_robot_description)/urdf/xiaoche_shiyan_control.urdf.xacro"/>

  <!-- ros2_control hardware/controller interfaces for the mobile base. -->
  <xacro:include filename="$(find my_robot_description)/urdf/xiaoche_hardware.ros2_control.xacro"/>
</robot>
