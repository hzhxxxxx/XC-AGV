<launch>
    <arg name="cam_sn1" default="None"/>
    <node pkg="mv3d_rgbd_ros2" exec="hik_camera_image_pub" name="hik_camera_image_pub" >
        <param name="cam_sn" value="$(var cam_sn1)" />
    </node>

    <node pkg="mv3d_rgbd_ros2" exec="hik_camera_image_sub" name="hik_camera_image_sub" >
    </node>

    <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share mv3d_rgbd_ros2)/config/ShowImage.rviz" />  
</launch>
