<launch>
    <arg name="cam_sn1" default="None"/>
    <arg name="cam_sn2" default="None"/>
    <node pkg="mv3d_rgbd_ros2" exec="hik_camera_image_client" name="hik_camera_image_client1" >
        <param name="cam_sn" value="$(var cam_sn1)" />
    </node>

    <node pkg="mv3d_rgbd_ros2" exec="hik_camera_image_client" name="hik_camera_image_client2" >
        <param name="cam_sn" value="$(var cam_sn2)" />
    </node>

    <node pkg="mv3d_rgbd_ros2" exec="hik_camera_image_server" name="hik_camera_image_server" >
    </node>
</launch>
